<%- include('partials/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-3">
    <div class="container-fluid px-4">
        <span class="navbar-brand fw-bold"><i class="fas fa-shopping-cart me-2"></i> POS - <%= user.username %> (<%= user.role %>)</span>
        <div>
            <% if(user.role === 'admin') { %>
                <a href="/admin" class="btn btn-light btn-sm fw-bold me-2"><i class="fas fa-user-shield me-1"></i> Admin Panel</a>
            <% } %>
            <a href="/logout" class="btn btn-outline-light btn-sm"><i class="fas fa-sign-out-alt me-1"></i> Logout</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4">
    <div class="row">
        <!-- Left: Product List & Filters -->
        <div class="col-md-7 col-lg-8">
            
            <!-- Search Bar & Category Filters -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <!-- Search Input -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Search by Product Name or Barcode..." oninput="debounceSearch()">
                            </div>
                        </div>
                        
                        <!-- Category Filter Buttons -->
                        <div class="col-md-6 d-flex gap-1 overflow-auto align-items-center">
                            <% categories.forEach(cat => { %>
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3 cat-btn <%= cat === 'ALL' ? 'active' : '' %>" onclick="filterCategory('<%= cat %>', this)"><%= cat %></button>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Products List Table -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0" style="max-height: 520px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" id="productTable">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 70px;">Image</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th class="text-end" style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <!-- <tbody id="productTableBody">
                            <% if(products.length === 0) { %>
                                <tr><td colspan="6" class="text-center text-muted py-4">No products available...</td></tr>
                            <% } %>
                            <% products.forEach(p => { %>
                                <tr>
                                    <td>
                                        <img src="<%= p.image || '/images/default-product.png' %>" width="45" height="45" class="rounded object-fit-cover">
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= p.name %></div>
                                        <% if(p.barcode) { %>
                                            <small class="text-muted"><i class="fas fa-barcode me-1"></i><%= p.barcode %></small>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-info text-dark"><%= p.category %></span></td>
                                    <td class="fw-bold text-primary"><%= p.price %> MMK</td>
                                    <td>
                                        <span class="badge <%= p.stock < 5 ? 'bg-danger' : 'bg-success' %>"><%= p.stock %></span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary fw-bold" onclick="addToCart('<%= p._id %>', '<%= p.name.replace(/'/g, "\\'") %>', <%= p.price %>, <%= p.stock %>)">
                                            <i class="fas fa-plus me-1"></i>Add
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody> -->

                        <tbody id="productTableBody">
                            <% if(products.length === 0) { %>
                                <tr><td colspan="6" class="text-center text-muted py-4">No products available...</td></tr>
                            <% } %>
                            <% products.forEach(p => { %>
                                <tr class="<%= p.stock <= 5 ? 'table-warning' : '' %>">
                                    <td>
                                        <img src="<%= p.image || '/images/default-product.png' %>" width="45" height="45" class="rounded object-fit-cover">
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= p.name %></div>
                                        <% if(p.barcode) { %>
                                            <small class="text-muted"><i class="fas fa-barcode me-1"></i><%= p.barcode %></small>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-info text-dark"><%= p.category %></span></td>
                                    <td class="fw-bold text-primary"><%= p.price %> MMK</td>
                                    <td>
                                        <!-- Stock ၅ ခုနဲ့ ၅ ခုအောက်ဆိုပါက အနီရောင် Flash Badge နှင့် Warning စာတမ်း ပြသမည် -->
                                        <% if(p.stock <= 5) { %>
                                            <span class="badge bg-danger fs-6 px-2 py-1"><%= p.stock %></span>
                                            <small class="text-danger fw-bold d-block style="font-size: 0.75rem;"><i class="fas fa-exclamation-circle me-1"></i>Reorder</small>
                                        <% } else { %>
                                            <span class="badge bg-success fs-6 px-2 py-1"><%= p.stock %></span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary fw-bold" onclick="addToCart('<%= p._id %>', '<%= p.name.replace(/'/g, "\\'") %>', <%= p.price %>, <%= p.stock %>)">
                                            <i class="fas fa-plus me-1"></i>Add
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Cart System -->
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-receipt me-2"></i> Current Order</span>
                    <button class="btn btn-sm btn-outline-danger px-3" onclick="clearCart()">Clear</button>
                </div>
                
                <!-- Cart List -->
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" id="cartList" style="max-height: 300px; overflow-y: auto;">
                        <li class="list-group-item text-center text-muted py-4">No cart items</li>
                    </ul>
                </div>

                <!-- Discount & Tax Inputs -->
                <div class="card-body border-top p-3 bg-light">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Discount (MMK)</label>
                            <input type="number" id="discountInput" class="form-control form-control-sm" value="0" min="0" oninput="calculateTotal()">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Tax (%)</label>
                            <input type="number" id="taxInput" class="form-control form-control-sm" value="0" min="0" oninput="calculateTotal()">
                        </div>
                    </div>
                </div>

                <!-- Calculation Summary & Checkout Button -->
                <div class="card-footer bg-white p-3">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Subtotal:</span>
                        <span id="subtotalAmount">0 MMK</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Tax Amount:</span>
                        <span id="taxAmount">0 MMK</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Discount:</span>
                        <span id="discountAmount">-0 MMK</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                        <span>Total:</span>
                        <span id="totalAmount" class="text-success">0 MMK</span>
                    </div>
                    <button class="btn btn-success w-100 fw-bold py-2" onclick="openPaymentModal()">
                        <i class="fas fa-check-circle me-1"></i> CHECKOUT
                    </button>
                </div>
            </div>
        </div>
        
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-cash-register me-2"></i> Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Payment Type</label>
                    <select id="paymentMethod" class="form-select" onchange="toggleCashInput()">
                        <option value="Cash">Cash (ငွေသား)</option>
                        <option value="KPay">KBZ Pay</option>
                        <option value="WavePay">Wave Pay</option>
                        <option value="MMQR">MMQR</option>
                        <option value="Banking">Banking</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ကျသင့်ငွေပေါင်း (Total)</label>
                    <input type="text" id="modalTotal" class="form-control fs-4 fw-bold text-success" readonly>
                </div>

                <div class="mb-3" id="paidAmountGroup">
                    <label class="form-label fw-bold">Customer ပေးငွေ (Paid Amount)</label>
                    <input type="number" id="paidAmount" class="form-control fs-4 fw-bold" placeholder="0" oninput="calculateChange()">
                </div>

                <div class="card bg-light border-0 p-3 text-center" id="changeGroup">
                    <div class="text-muted small mb-1">ပြန်အမ်းငွေ (Change)</div>
                    <div id="changeAmount" class="fw-bold fs-4 text-primary">0 MMK</div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success fw-bold" onclick="confirmPayment()"><i class="fas fa-check me-1"></i> Confirm Payment</button>
            </div>
        </div>
    </div>
</div>

<script>
let cart = [];
let selectedCategory = 'ALL';
let searchTimeout = null;

// Real-time Search Function
async function fetchProductsFromDB() {
    const query = document.getElementById('searchInput').value.trim();

    try {
        const response = await fetch(`/pos/search?q=${encodeURIComponent(query)}&category=${encodeURIComponent(selectedCategory)}`);
        const data = await response.json();

        if (data.success) {
            renderProductTable(data.products);
        }
    } catch (err) {
        console.error("Fetch search error:", err);
    }
}

function debounceSearch() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        fetchProductsFromDB();
    }, 300);
}

function filterCategory(cat, btn) {
    selectedCategory = cat;
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    fetchProductsFromDB();
}

function renderProductTable(products) {
    const tbody = document.getElementById('productTableBody');

    if (!products || products.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Stock မရှိပါ။</td></tr>';
        return;
    }

    let html = '';
    products.forEach(p => {
        const imageHtml = p.image 
            ? `<img src="${p.image}" width="45" height="45" class="rounded object-fit-cover">`
            : `<div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"><i class="fas fa-box text-muted"></i></div>`;

        const barcodeHtml = p.barcode ? `<small class="text-muted"><i class="fas fa-barcode me-1"></i>${p.barcode}</small>` : '';

        html += `
            <tr>
                <td>${imageHtml}</td>
                <td>
                    <div class="fw-bold text-dark">${p.name}</div>
                    ${barcodeHtml}
                </td>
                <td><span class="badge bg-info text-dark">${p.category}</span></td>
                <td class="fw-bold text-primary">${p.price} MMK</td>
                <td>
                    <span class="badge ${p.stock < 5 ? 'bg-danger' : 'bg-success'}">${p.stock}</span>
                </td>
                <td class="text-end">
                    <button class="btn btn-sm btn-primary fw-bold" onclick="addToCart('${p._id}', '${p.name.replace(/'/g, "\\'")}', ${p.price}, ${p.stock})">
                        <i class="fas fa-plus me-1"></i> Add
                    </button>
                </td>
            </tr>
        `;
    });

    tbody.innerHTML = html;
}

// Cart ထဲ ပစ္စည်းထည့်ခြင်း (Backend နဲ့ ကိုက်အောင် id နဲ့ quantity field Name များကို ထည့်ပေးထားသည်)
function addToCart(id, name, price, stock) {
    const existing = cart.find(item => item.id === id);
    if (existing) {
        if (existing.quantity < stock) {
            existing.quantity += 1;
        } else {
            alert(`Stock မလုံလောက်ပါ။ (ကျန်ရှိ Stock: ${stock})`);
        }
    } else {
        cart.push({ id: id, _id: id, name: name, price: price, stock: Number(stock), quantity: 1, qty: 1 });
    }
    updateCartUI();
}

function updateQty(id, newQty) {
    const item = cart.find(i => i.id === id);
    if (!item) return;

    let qty = parseInt(newQty);
    if (isNaN(qty) || qty <= 0) {
        removeFromCart(id);
        return;
    }

    if (qty > item.stock) {
        alert(`Stock မလုံလောက်ပါ! (ကျန်ရှိ Stock: ${item.stock})`);
        item.quantity = item.stock;
        item.qty = item.stock;
    } else {
        item.quantity = qty;
        item.qty = qty;
    }
    updateCartUI();
}

function removeFromCart(id) {
    cart = cart.filter(item => item.id !== id);
    updateCartUI();
}

function clearCart() {
    cart = [];
    updateCartUI();
}

function updateCartUI() {
    const cartList = document.getElementById('cartList');
    if (cart.length === 0) {
        cartList.innerHTML = '<li class="list-group-item text-center text-muted py-4">No cart items</li>';
        calculateTotal();
        return;
    }

    cartList.innerHTML = cart.map(item => `
        <li class="list-group-item d-flex align-items-center justify-content-between p-2">
            <div style="width: 35%;">
                <div class="fw-bold text-truncate">${item.name}</div>
                <small class="text-muted">${item.price.toLocaleString()} MMK</small>
            </div>
            <div class="d-flex align-items-center gap-1" style="width: 40%;">
                <button class="btn btn-sm btn-outline-secondary px-2" onclick="updateQty('${item.id}', ${item.quantity - 1})">-</button>
                <input type="number" class="form-control form-control-sm text-center p-1" value="${item.quantity}" min="1" max="${item.stock}" onchange="updateQty('${item.id}', this.value)">
                <button class="btn btn-sm btn-outline-secondary px-2" onclick="updateQty('${item.id}', ${item.quantity + 1})">+</button>
            </div>
            <div class="text-end" style="width: 25%;">
                <div class="fw-bold small">${(item.price * item.quantity).toLocaleString()}</div>
                <button class="btn btn-link text-danger p-0 border-0 ms-1" onclick="removeFromCart('${item.id}')"><i class="fas fa-trash-alt"></i></button>
            </div>
        </li>
    `).join('');

    calculateTotal();
}

function calculateTotal() {
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const discount = parseFloat(document.getElementById('discountInput').value) || 0;
    const taxPercent = parseFloat(document.getElementById('taxInput').value) || 0;

    const taxAmount = (subtotal - discount) > 0 ? ((subtotal - discount) * taxPercent) / 100 : 0;
    const total = Math.max(0, (subtotal - discount) + taxAmount);

    document.getElementById('subtotalAmount').innerText = subtotal.toLocaleString() + ' MMK';
    document.getElementById('taxAmount').innerText = taxAmount.toLocaleString() + ' MMK';
    document.getElementById('discountAmount').innerText = '-' + discount.toLocaleString() + ' MMK';
    document.getElementById('totalAmount').innerText = total.toLocaleString() + ' MMK';

    return { subtotal, discount, taxAmount, total };
}

function openPaymentModal() {
    if (cart.length === 0) {
        alert("Cart ထဲတွင် ပစ္စည်းမရှိပါ။");
        return;
    }
    const { total } = calculateTotal();
    document.getElementById('modalTotal').value = total.toLocaleString() + ' MMK';
    document.getElementById('paidAmount').value = total;
    calculateChange();
    
    const paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
    paymentModal.show();
}

function calculateChange() {
    const { total } = calculateTotal();
    const paid = parseFloat(document.getElementById('paidAmount').value) || 0;
    const change = paid - total;
    
    const changeElem = document.getElementById('changeAmount');
    if (change < 0) {
        changeElem.className = 'fw-bold fs-4 text-danger';
        changeElem.innerText = `လိုငွေ: ${Math.abs(change).toLocaleString()} MMK`;
    } else {
        changeElem.className = 'fw-bold fs-4 text-primary';
        changeElem.innerText = `${change.toLocaleString()} MMK`;
    }
}

function toggleCashInput() {
    const method = document.getElementById('paymentMethod').value;
    const paidGroup = document.getElementById('paidAmountGroup');
    const changeGroup = document.getElementById('changeGroup');
    
    if (method !== 'Cash') {
        paidGroup.style.display = 'none';
        changeGroup.style.display = 'none';
    } else {
        paidGroup.style.display = 'block';
        changeGroup.style.display = 'block';
    }
}

async function confirmPayment() {
    const { subtotal, discount, taxAmount, total } = calculateTotal();
    const paymentMethod = document.getElementById('paymentMethod').value;
    const paidAmount = parseFloat(document.getElementById('paidAmount').value) || 0;
    
    if (paymentMethod === 'Cash' && paidAmount < total) {
        alert("Customer ပေးငွေသည် ကျသင့်ငွေထက် နည်းနေပါသည်။");
        return;
    }

    const orderData = {
        items: cart,
        subtotal,
        discount,
        taxAmount,
        totalAmount: total, // app.js ၏ req.body.totalAmount အတွက်ပါ ထည့်ပေးထားသည်
        total,
        paymentMethod,
        paidAmount: paymentMethod === 'Cash' ? paidAmount : total,
        changeAmount: paymentMethod === 'Cash' ? (paidAmount - total) : 0
    };

    try {
        const response = await fetch('/pos/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderData)
        });

        const resData = await response.json();

        if (response.ok && resData.success !== false) {
            alert(resData.message || "ရောင်းချမှု အောင်မြင်ပါသည်။");
            cart = [];
            updateCartUI();
            
            const modalElem = document.getElementById('paymentModal');
            const modalInstance = bootstrap.Modal.getInstance(modalElem);
            if (modalInstance) modalInstance.hide();
            
            location.reload();
        } else {
            alert(resData.message || "Checkout ပြုလုပ်ခြင်း မအောင်မြင်ပါ။");
        }
    } catch (err) {
        console.error("Checkout error:", err);
        alert("Server နှင့် ချိတ်ဆက်ရာတွင် အမှားအယွင်း ရှိနေပါသည်။");
    }
}
</script>

<%- include('partials/footer') %>
