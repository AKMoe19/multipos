<!-- Main Footer -->
    <footer class="bg-dark text-light pt-4 pb-3 mt-auto border-top border-secondary-subtle">
        <div class="container-fluid px-4">
            <div class="row gy-3 align-items-center">
                <!-- Brand & System Info -->
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-1">
                        <span class="fw-bold fs-5 text-white">Multi-POS System</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 px-2 py-1" style="font-size: 0.7rem;">v1.0</span>
                    </div>
                    <p class="text-secondary small mb-0">
                        Multi-POS of Sale Solution & Inventory Management
                    </p>
                </div>

                <!-- Quick Status & Copyright -->
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-end gap-3 mb-1">
                        <span class="small text-secondary">
                            <i class="fas fa-circle text-success me-1" style="font-size: 0.5rem;"></i> System Online
                        </span>
                        <span class="text-secondary">|</span>
                        <span class="small text-secondary">
                            <i class="fas fa-user-shield text-info me-1"></i> <%= typeof user !== 'undefined' && user ? user.username : 'Guest' %>
                        </span>
                    </div>
                    <p class="text-secondary small mb-0">
                        &copy; <%= new Date().getFullYear() %> All Rights Reserved. Powered by AkM.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
